<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RDFincorp - Register</title>
    <link rel="stylesheet" href="/css/login.css">
</head>

<body>
    <div class="container">
        <div class="left-panel">
            <div class="branding">
                <div class="logo">
                    <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
                        <circle cx="20" cy="20" r="18" stroke="#4c6fff" stroke-width="2" />
                        <path d="M20 10 L20 30 M12 20 L28 20" stroke="#4c6fff" stroke-width="2" />
                    </svg>
                    <h1>RDFincorp</h1>
                </div>
            </div>

            <div class="tagline" style="margin-top: 120px;">
                <h2>Join RDFincorp</h2>
                <p>Modern banking at your fingertips</p>
                <p style="margin-top: 20px; color: #7b7b8c;">Get instant account number and credit card upon
                    registration</p>
            </div>
        </div>

        <div class="right-panel">
            <div class="login-form">
                <h2>Create Account</h2>
                <p class="subtitle">Join thousands of satisfied customers</p>

                <% if (error) { %>
                    <div class="error-message">
                        <%= error %>
                    </div>
                    <% } %>

                        <% if (success) { %>
                            <div class="success-message">
                                <%= success %>
                            </div>
                            <% } %>

                                <form action="/auth/register" method="POST">
                                    <div class="form-group">
                                        <input type="text" name="full_name" placeholder="Full Name" required>
                                    </div>

                                    <div class="form-group">
                                        <input type="email" name="email" placeholder="Email Address" required>
                                    </div>

                                    <div class="form-group">
                                        <input type="password" name="password" placeholder="Password (min 8 characters)"
                                            required>
                                    </div>

                                    <button type="submit" class="login-btn">Create Account</button>
                                </form>

                                <p class="signup-link">
                                    Already have an account? <a href="/auth/login">Login</a>
                                </p>

                                <p class="footer-text">© 2026 ALL RIGHTS RESERVED</p>
            </div>
        </div>
    </div>
</body>

</html>
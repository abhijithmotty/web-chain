<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password — RDFincorp Banking</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/login.css">
    <link rel="stylesheet" href="/css/difficulty.css">
</head>
<body data-difficulty="<%= difficulty %>" data-locked="<%= difficultyLocked %>">
    <div class="login-container">
        <div class="login-box">
            <div class="logo-section">
                <div class="logo-circle">
                    <svg width="50" height="50" viewBox="0 0 50 50" fill="none">
                        <circle cx="25" cy="25" r="22" stroke="url(#gradient)" stroke-width="2" />
                        <path d="M25 12 L25 38 M15 25 L35 25" stroke="url(#gradient)" stroke-width="2.5" />
                        <defs>
                            <linearGradient id="gradient" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" style="stop-color:#8B7355" />
                                <stop offset="100%" style="stop-color:#D4AF37" />
                            </linearGradient>
                        </defs>
                    </svg>
                </div>
            </div>

            <h1>Set New Password</h1>
            <p class="subtitle">Enter your reset token and new password</p>

            <% if (error) { %>
                <div class="error-box">⚠️ <%= error %></div>
            <% } %>

            <% if (success) { %>
                <div class="success-box"><%- success %></div>
            <% } else { %>
            <form action="/auth/reset-password" method="POST">
                <div class="input-group">
                    <label for="token">Reset Token</label>
                    <input type="text" id="token" name="token" value="<%= token || '' %>" placeholder="Enter your 6-digit token" required>
                </div>
                <div class="input-group">
                    <label for="password">New Password</label>
                    <input type="password" id="password" name="password" placeholder="Enter new password" required>
                </div>
                <button type="submit" class="login-button"><span>Reset Password</span></button>
            </form>

            <div class="vuln-notice">
                <strong>Attack Hints:</strong>
                <ul style="margin:8px 0 0;padding-left:20px;font-size:12px">
                    <li><strong>Easy:</strong> Token is 000000–999999. Brute-force with: <code>for i in $(seq -w 0 999999); do curl -s -X POST .../reset-password -d "token=$i&amp;password=hacked"; done</code></li>
                    <li><strong>Medium:</strong> Same token works repeatedly — account takeover anytime</li>
                    <li><strong>Hard:</strong> Random token, but can be reused until server restart</li>
                </ul>
            </div>
            <% } %>

            <div class="signup-footer">
                <a href="/auth/forgot-password">← Back to Forgot Password</a> |
                <a href="/auth/login">Login</a>
            </div>
        </div>
    </div>

    <style>
        .success-box { background:rgba(0,200,83,0.1); border:1px solid rgba(0,200,83,0.3); color:#69f0ae; padding:12px 16px; border-radius:8px; margin-bottom:16px; font-size:13px; }
        .success-box a { color:#4c6fff; }
        .vuln-notice { margin-top:20px; padding:12px; background:rgba(255,160,0,0.08); border:1px solid rgba(255,160,0,0.3); border-radius:8px; font-size:12px; color:#ffd700; }
        .vuln-notice li { margin-top:4px; color:#94a3b8; }
        .vuln-notice li strong { color:#ffd700; }
        .vuln-notice code { background:rgba(0,0,0,0.4); padding:2px 5px; border-radius:3px; color:#f8f8f2; font-size:10px; }
    </style>
    <script src="/js/difficulty.js"></script>
</body>
</html>

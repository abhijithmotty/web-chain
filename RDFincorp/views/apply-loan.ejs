<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Apply for Loan - RDFincorp</title>
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>

<body>
    <div class="dashboard">
        <aside class="sidebar">
            <div class="logo">
                <svg width="32" height="32" viewBox="0 0 40 40" fill="none">
                    <circle cx="20" cy="20" r="18" stroke="#4c6fff" stroke-width="2" />
                    <path d="M20 10 L20 30 M12 20 L28 20" stroke="#4c6fff" stroke-width="2" />
                </svg>
                <span>RDFincorp</span>
            </div>

            <nav class="nav-menu">
                <a href="/user/dashboard" class="nav-item">
                    <span class="icon">📊</span>
                    <span>Dashboard</span>
                </a>
                <a href="/user/apply-card" class="nav-item">
                    <span class="icon">🎴</span>
                    <span>Apply Card</span>
                </a>
                <a href="/user/apply-loan" class="nav-item active">
                    <span class="icon">💰</span>
                    <span>Apply Loan</span>
                </a>
                <a href="/user/profile" class="nav-item">
                    <span class="icon">👤</span>
                    <span>Profile</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <a href="/auth/logout" class="nav-item">
                    <span class="icon">🚪</span>
                    <span>Logout</span>
                </a>
            </div>
        </aside>

        <main class="main-content">
            <header class="top-bar">
                <h1>Apply for Loan</h1>
                <div class="user-info">
                    <span class="user-name">
                        <%= user.full_name %>
                    </span>
                    <div class="user-avatar">
                        <%= user.full_name.charAt(0) %>
                    </div>
                </div>
            </header>

            <div class="content">
                <div class="application-container">
                    <div class="info-card">
                        <h3>Loan Eligibility</h3>
                        <div class="profile-info">
                            <div class="info-item">
                                <span class="info-label">Credit Score</span>
                                <span class="info-value <%= user.credit_score > 700 ? 'good' : 'average' %>">
                                    <%= user.credit_score %>
                                </span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Maximum Eligible Amount</span>
                                <span class="info-value">$<%= (user.credit_score * 100).toFixed(2) %></span>
                            </div>
                        </div>

                        <p class="info-text">
                            Your loan application will be reviewed by our admin team.
                            Approval is based on your credit score and account history.
                        </p>
                    </div>

                    <% if (success) { %>
                        <div class="success-message">
                            <%= success %>
                        </div>
                        <% } %>

                            <% if (error) { %>
                                <div class="error-message">
                                    <%= error %>
                                </div>
                                <% } %>

                                    <form action="/user/apply-loan" method="POST" class="application-form loan-form">
                                        <h3>Loan Application</h3>

                                        <div class="form-group">
                                            <label for="amount">Loan Amount ($)</label>
                                            <input type="number" id="amount" name="amount" min="1000" max="100000"
                                                step="100" required placeholder="Enter amount">
                                        </div>

                                        <div class="form-group">
                                            <label for="purpose">Loan Purpose</label>
                                            <textarea id="purpose" name="purpose" rows="4" required
                                                placeholder="Describe why you need this loan (e.g., Home renovation, Car purchase, Business expansion)"></textarea>
                                        </div>

                                        <div class="loan-terms">
                                            <h4>Estimated Terms</h4>
                                            <div class="term-info">
                                                <span>Interest Rate:</span>
                                                <span class="term-value">
                                                    <%= user.credit_score> 700 ? '5.5%' : user.credit_score > 650 ?
                                                        '7.5%' : '10.5%' %> APR
                                                </span>
                                            </div>
                                            <div class="term-info">
                                                <span>Loan Term:</span>
                                                <span class="term-value">12-60 months</span>
                                            </div>
                                        </div>

                                        <button type="submit" class="btn-submit">Submit Loan Application</button>
                                    </form>
                </div>
            </div>
        </main>
    </div>
</body>

</html>
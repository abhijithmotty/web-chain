<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Apply for Credit Card - RDFincorp</title>
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>

<body>
    <div class="dashboard">
        <aside class="sidebar">
            <div class="logo">
                <svg width="32" height="32" viewBox="0 0 40 40" fill="none">
                    <circle cx="20" cy="20" r="18" stroke="#4c6fff" stroke-width="2" />
                    <path d="M20 10 L20 30 M12 20 L28 20" stroke="#4c6fff" stroke-width="2" />
                </svg>
                <span>RDFincorp</span>
            </div>

            <nav class="nav-menu">
                <a href="/user/dashboard" class="nav-item">
                    <span class="icon">📊</span>
                    <span>Dashboard</span>
                </a>
                <a href="/user/apply-card" class="nav-item active">
                    <span class="icon">🎴</span>
                    <span>Apply Card</span>
                </a>
                <a href="/user/apply-loan" class="nav-item">
                    <span class="icon">💰</span>
                    <span>Apply Loan</span>
                </a>
                <a href="/user/profile" class="nav-item">
                    <span class="icon">👤</span>
                    <span>Profile</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <a href="/auth/logout" class="nav-item">
                    <span class="icon">🚪</span>
                    <span>Logout</span>
                </a>
            </div>
        </aside>

        <main class="main-content">
            <header class="top-bar">
                <h1>Apply for Credit Card</h1>
                <div class="user-info">
                    <span class="user-name">
                        <%= user.full_name %>
                    </span>
                    <div class="user-avatar">
                        <%= user.full_name.charAt(0) %>
                    </div>
                </div>
            </header>

            <div class="content">
                <div class="application-container">
                    <div class="info-card">
                        <h3>Your Credit Profile</h3>
                        <div class="profile-info">
                            <div class="info-item">
                                <span class="info-label">Credit Score</span>
                                <span class="info-value <%= user.credit_score > 700 ? 'good' : 'average' %>">
                                    <%= user.credit_score %>
                                </span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Current Balance</span>
                                <span class="info-value">$<%= user.balance.toFixed(2) %></span>
                            </div>
                        </div>

                        <div class="eligibility">
                            <% if (user.credit_score>= 750) { %>
                                <p class="eligible">✓ Eligible for all card types</p>
                                <% } else if (user.credit_score>= 650) { %>
                                    <p class="eligible">✓ Eligible for Silver and Gold cards</p>
                                    <% } else { %>
                                        <p class="normal">✓ Eligible for Basic and Silver cards</p>
                                        <% } %>
                        </div>
                    </div>

                    <% if (success) { %>
                        <div class="success-message">
                            <%= success %>
                        </div>
                        <% } %>

                            <% if (error) { %>
                                <div class="error-message">
                                    <%= error %>
                                </div>
                                <% } %>

                                    <form action="/user/apply-card" method="POST" class="application-form">
                                        <h3>Select Card Type</h3>

                                        <div class="card-options">
                                            <label class="card-option">
                                                <input type="radio" name="card_type" value="silver" required>
                                                <div class="option-card silver-card">
                                                    <h4>Silver Card</h4>
                                                    <p class="credit-limit">$10,000 Credit Limit</p>
                                                    <ul class="benefits">
                                                        <li>2% cashback on purchases</li>
                                                        <li>Travel insurance</li>
                                                        <li>24/7 support</li>
                                                    </ul>
                                                    <p class="requirement">Min. Credit Score: 600</p>
                                                </div>
                                            </label>

                                            <label class="card-option">
                                                <input type="radio" name="card_type" value="gold">
                                                <div class="option-card gold-card">
                                                    <h4>Gold Card</h4>
                                                    <p class="credit-limit">$25,000 Credit Limit</p>
                                                    <ul class="benefits">
                                                        <li>5% cashback on purchases</li>
                                                        <li>Premium travel insurance</li>
                                                        <li>Airport lounge access</li>
                                                        <li>Concierge service</li>
                                                    </ul>
                                                    <p class="requirement">Min. Credit Score: 700</p>
                                                </div>
                                            </label>

                                            <label class="card-option">
                                                <input type="radio" name="card_type" value="platinum">
                                                <div class="option-card platinum-card">
                                                    <h4>Platinum Card</h4>
                                                    <p class="credit-limit">$50,000 Credit Limit</p>
                                                    <ul class="benefits">
                                                        <li>10% cashback on purchases</li>
                                                        <li>Exclusive travel benefits</li>
                                                        <li>Priority airport services</li>
                                                        <li>Personal account manager</li>
                                                        <li>Luxury hotel discounts</li>
                                                    </ul>
                                                    <p class="requirement">Min. Credit Score: 750</p>
                                                </div>
                                            </label>
                                        </div>

                                        <button type="submit" class="btn-submit">Submit Application</button>
                                    </form>
                </div>
            </div>
        </main>
    </div>
</body>

</html>
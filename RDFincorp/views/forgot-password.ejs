<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password — RDFincorp Banking</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/login.css">
    <link rel="stylesheet" href="/css/difficulty.css">
</head>
<body data-difficulty="<%= difficulty %>" data-locked="<%= difficultyLocked %>">
    <div class="login-container">
        <div class="login-box">
            <div class="logo-section">
                <div class="logo-circle">
                    <svg width="50" height="50" viewBox="0 0 50 50" fill="none">
                        <circle cx="25" cy="25" r="22" stroke="url(#gradient)" stroke-width="2" />
                        <path d="M25 12 L25 38 M15 25 L35 25" stroke="url(#gradient)" stroke-width="2.5" />
                        <defs>
                            <linearGradient id="gradient" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" style="stop-color:#8B7355" />
                                <stop offset="100%" style="stop-color:#D4AF37" />
                            </linearGradient>
                        </defs>
                    </svg>
                </div>
            </div>

            <h1>Reset Password</h1>
            <p class="subtitle">Enter your email to receive a reset token</p>

            <% if (error) { %>
                <div class="error-box">⚠️ <%= error %></div>
            <% } %>

            <% if (success) { %>
                <div class="success-box"><%- success %></div>
            <% } %>

            <% if (!success) { %>
            <form action="/auth/forgot-password" method="POST">
                <div class="input-group">
                    <label for="email">Email Address</label>
                    <input type="text" id="email" name="email" placeholder="Enter your account email" required>
                </div>
                <button type="submit" class="login-button">
                    <span>Send Reset Token</span>
                </button>
            </form>
            <% } %>

            <div class="vuln-notice">
                <strong>Vulnerability Notes:</strong>
                <ul style="margin:8px 0 0;padding-left:20px;font-size:12px">
                    <li><strong>Easy:</strong> Token shown directly in response (no email needed)</li>
                    <li><strong>Medium:</strong> Token sent, but never expires — reusable forever</li>
                    <li><strong>Hard:</strong> Proper token but no invalidation on use</li>
                </ul>
            </div>

            <div class="signup-footer">
                <a href="/auth/login">← Back to Login</a>
            </div>
        </div>
    </div>

    <style>
        .success-box { background:rgba(0,200,83,0.1); border:1px solid rgba(0,200,83,0.3); color:#69f0ae; padding:12px 16px; border-radius:8px; margin-bottom:16px; font-size:13px; line-height:1.6; }
        .success-box code { background:rgba(0,0,0,0.3); padding:2px 6px; border-radius:4px; color:#ffd700; }
        .vuln-notice { margin-top:20px; padding:12px; background:rgba(255,160,0,0.08); border:1px solid rgba(255,160,0,0.3); border-radius:8px; font-size:12px; color:#ffd700; }
        .vuln-notice li { margin-top:4px; color:#94a3b8; }
        .vuln-notice li strong { color:#ffd700; }
    </style>
    <script src="/js/difficulty.js"></script>
</body>
</html>
